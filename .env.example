# ==================================
# Environment Configuration Template
# ==================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ==================================
# PostgreSQL Database
# ==================================
POSTGRES_USER=wpp_disp
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=wpp_disp_db
POSTGRES_PORT=5432

# ==================================
# GoHighLevel API Configuration
# ==================================
# Get these from: https://marketplace.gohighlevel.com/
GHL_CLIENT_ID=your_ghl_client_id_here
GHL_CLIENT_SECRET=your_ghl_client_secret_here
GHL_REDIRECT_URI=http://localhost:8000/ghl/oauth/callback
GHL_WEBHOOK_SECRET=your_webhook_secret_here

# ==================================
# Token Encryption
# ==================================
# Generate a new key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GHL_TOKEN_ENCRYPTION_KEY=GENERATE_NEW_FERNET_KEY_HERE

# ==================================
# Application Settings
# ==================================
DEBUG=True
LOG_LEVEL=INFO

# Backend port
BACKEND_PORT=8000

# Frontend port
FRONTEND_PORT=3001

# Frontend API URL (for production, use your VPS domain)
VITE_API_URL=http://localhost:8000
