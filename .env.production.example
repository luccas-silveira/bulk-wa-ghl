# ==================================
# Production Environment Configuration
# ==================================
# Copy this file to .env.production on your VPS
# Fill in with your production values
# Store in a secure location (e.g., /var/www/wpp_disp/.env.production)

# ==================================
# PostgreSQL Database (Production)
# ==================================
POSTGRES_USER=wpp_disp_prod
POSTGRES_PASSWORD=VERY_STRONG_PASSWORD_HERE_MIN_32_CHARS
POSTGRES_DB=wpp_disp_production
POSTGRES_PORT=5432

# ==================================
# GoHighLevel API Configuration
# ==================================
GHL_CLIENT_ID=your_production_ghl_client_id
GHL_CLIENT_SECRET=your_production_ghl_client_secret
GHL_REDIRECT_URI=https://your-domain.com/ghl/oauth/callback
GHL_WEBHOOK_SECRET=your_production_webhook_secret_min_32_chars

# ==================================
# Token Encryption (CRITICAL!)
# ==================================
# Generate a NEW key for production - DO NOT use dev key!
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GHL_TOKEN_ENCRYPTION_KEY=PRODUCTION_FERNET_KEY_HERE

# ==================================
# Application Settings (Production)
# ==================================
DEBUG=False
LOG_LEVEL=WARNING

# Ports (internal Docker network)
BACKEND_PORT=8000
FRONTEND_PORT=3001

# Frontend API URL (your VPS domain)
VITE_API_URL=https://your-domain.com/api

# ==================================
# Optional: SMTP for notifications (future)
# ==================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ==================================
# Security Notes
# ==================================
# 1. This file should have chmod 600 permissions
# 2. Store backup in secure password manager
# 3. Never commit to version control
# 4. Rotate secrets regularly
# 5. Use different values than development
